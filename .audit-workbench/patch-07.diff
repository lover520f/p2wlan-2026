+			s.revocationMu.RUnlock()
+			if !feedReady {
+				setCloseCause("revocation_feed_unavailable")
+				_ = conn.SetWriteDeadline(time.Now().Add(time.Second))
+				_ = writeFull(conn, errorFrame(503, "relay authorization temporarily unavailable"))
